[Unit]
Description=Tender daemon (whole-server backups, usage, services and security checks, reports to the hub)
Documentation=https://github.com/g4f4r0/tender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The daemon runs as root. It backs up every file, controls Docker and reads the journal, which made
# it root-equivalent as the tender user too. The sandbox below keeps a bug from changing the system:
# it writes only its own folders. The hub, the part on the network, stays the tender user.
User=root
Group=root
ExecStart=/usr/local/bin/tender daemon --config /etc/tender/daemon.toml
Restart=always
RestartSec=30
# The daemon runs at normal priority, so its Docker pings and reports keep time. It starts restic at the
# lowest CPU and IO priority, to be gentle with the host while backing it up; the system call filter below
# lets it lower a priority, and without CAP_SYS_NICE it can't raise one.

# Own directories: /var/lib/tender/daemon, /var/lib/tender/services (a folder per managed service, which the
# whole-server backup includes), /var/cache/tender (restic cache), /etc/tender (root-owned, read-only).
StateDirectory=tender/daemon tender/services
StateDirectoryMode=0700
CacheDirectory=tender
CacheDirectoryMode=0700
ConfigurationDirectory=tender
Environment=RESTIC_CACHE_DIR=%C/tender
Environment=TENDER_RESTIC_BIN=/usr/local/bin/restic

# The hub token is the one file in /etc/tender/credentials (0750 root:tender, file 0640). The daemon gets
# its destination and keys from the hub and keeps them in its state folder.

# Read every file (CAP_DAC_READ_SEARCH), read the firewall's rules (CAP_NET_ADMIN) and name the process
# behind each listening socket (CAP_SYS_PTRACE). Nothing else: no CAP_DAC_OVERRIDE, so it can't write
# another user's files, and no CAP_SYS_ADMIN. Updating Tender and upgrading the system's packages run
# outside this sandbox, as transient units (tenderupdate, tenderupgrade) through systemd-run. It runs
# without --wait or --pipe, so as root systemd-run, and systemctl, reach systemd over its private
# socket, /run/systemd/private, where systemd trusts uid 0: that needs no D-Bus, no polkit and no
# CAP_SYS_ADMIN, which systemd before v256 may ask of a caller that comes through D-Bus.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_SYS_PTRACE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=default
ProcSubset=all
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# AF_NETLINK: ss and nft read sockets and firewall rules over netlink.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=setpriority sched_setscheduler ioprio_set
# A program the daemon runs, such as sshd -T or apt-get, gets an error for a call outside the filter
# instead of being killed.
SystemCallErrorNumber=EPERM
SocketBindDeny=any
UMask=0077
KeyringMode=private
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
