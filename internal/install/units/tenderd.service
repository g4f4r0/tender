[Unit]
Description=Tender daemon (whole-server backups and usage, reports to the hub)
Documentation=https://github.com/g4f4r0/tender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tender
Group=tender
ExecStart=/usr/local/bin/tender daemon --config /etc/tender/daemon.toml
Restart=always
RestartSec=30
# Be gentle with the host while backing it up.
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# Own directories: /var/lib/tender/daemon, /var/cache/tender (restic cache), /etc/tender (root-owned, read-only).
StateDirectory=tender/daemon
StateDirectoryMode=0700
CacheDirectory=tender
CacheDirectoryMode=0700
ConfigurationDirectory=tender
Environment=RESTIC_CACHE_DIR=%C/tender
Environment=TENDER_RESTIC_BIN=/usr/local/bin/restic

# The hub token is the one file in /etc/tender/credentials (0750 root:tender, file 0640). The daemon gets
# its destination and keys from the hub and keeps them in its state folder.

# Read every file, write nothing outside the directories above.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
ProtectProc=default
ProcSubset=all
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SocketBindDeny=any
UMask=0077
KeyringMode=private
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
